[flake8]
max-line-length = 88
exclude =
    .git,
    __pycache__,
    node_modules,
    dash/deps,
    dash/labextension/node_modules,
    PyQt6,
    OpenGL,
    Sids_3dx_Utils.exe,
    vendor_binaries,
    build,
    dist,
    *.pyc,
    *.dist-info,
    IPython,
    cv2,
    plotly,
    plotly-*,
    skimage,
    numpy*,
    scipy*,
    jedi,
    parso,
    nbformat,
    flask*,
    werkzeug*,
    prompt_toolkit*
ignore = E203, W503
